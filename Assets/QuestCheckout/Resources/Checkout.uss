.text { color: rgb(6, 6, 6); -unity-text-align: middle-center; white-space: normal; margin: 0; padding: 0; }
.muted { color: rgb(92, 100, 105); }
.footer { color: rgb(125, 132, 137); -unity-text-align: middle-left; letter-spacing: 1px; }
Button { margin: 0; border-width: 0; padding: 0; -unity-font-style: bold; -unity-text-align: middle-center; font-size: 27px; white-space: normal; border-radius: 17px; }
Button.primary, Button.selected { background-color: rgb(105, 162, 184); color: white; }
Button.primary:hover, Button.selected:hover { background-color: rgb(78, 140, 164); }
Button.primary:active, Button.selected:active { background-color: rgb(48, 107, 131); }
Button.secondary { border-width: 2px; border-color: rgb(105, 162, 184); background-color: white; color: rgb(52, 106, 127); font-size: 22px; border-radius: 10px; }
Button.secondary:hover { background-color: rgb(231, 243, 247); }
Button.category, Button.kit, Button.icon-button { background-color: white; color: black; border-radius: 8px; }
Button.icon-button:hover { background-color: rgb(239, 247, 250); }
.hover-art { transition-property: scale; transition-duration: 0.16s; scale: 1 1; }
.panther-hover .hover-art { scale: 1.15 1.15; }
Button.category:focus, Button.kit:focus, Button.icon-button:focus, Button.primary:focus, Button.secondary:focus, Button.selected:focus, Button.quiet:focus { border-width: 3px; border-color: rgb(37, 91, 117); }
Button:disabled { opacity: 0.5; }
Button.kit:disabled { opacity: 1; }
Button.quiet { background-color: rgb(244, 247, 248); color: rgb(86, 108, 116); font-size: 14px; border-radius: 6px; }
.card { background-color: rgb(248, 248, 248); border-radius: 17px; border-width: 1px; border-color: rgb(237, 237, 237); overflow: hidden; }
.card-header { background-color: rgb(105, 162, 184); color: white; }
.selected { font-size: 22px; border-radius: 10px; }
.check { color: rgb(20, 25, 28); font-size: 22px; }
.check .unity-toggle__input { background-color: transparent; border-width: 0; }
.check .unity-toggle__checkmark { background-color: white; border-width: 2px; border-color: rgb(105, 162, 184); border-radius: 5px; width: 29px; height: 29px; }
.check .unity-toggle__text { margin-left: 12px; }
.check:focus { background-color: rgb(231, 243, 247); }
.overlay { background-color: rgba(25, 44, 52, 0.35); }
.alert { color: rgb(150, 44, 30); background-color: rgb(255, 240, 235); border-radius: 6px; }
